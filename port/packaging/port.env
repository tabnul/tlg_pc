# Port profile read by the packaging scripts and the CI: one file per port, same keys everywhere.
PORT_NAME="The Last Guardian"       # executable, window and menu entry name
PORT_SLUG="tlg"                     # package prefix: <slug>-linux-x86_64.tar.gz, <slug>-windows-x86_64.zip
PORT_LAUNCHER="tlg_launcher.py"     # port/launcher/<file>: the launcher (Tk), frozen with PyInstaller
PORT_ICON="tlg"                     # port/launcher/<icon>.png and .ico (original art, never the game's)
PORT_TITLE_ID="CUSA03627"
